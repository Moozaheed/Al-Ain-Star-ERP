# Copy to .env — never commit .env to git

# ── App ──────────────────────────────────────────────────────
APP_KEY=

# ── Database ─────────────────────────────────────────────────
DB_ROOT_PASSWORD=rootsecret
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=erp_secret
DB_PORT=3306

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# ── Ports ────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
MAILPIT_UI_PORT=8025
